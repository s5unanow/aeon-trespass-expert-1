{
  "$defs": {
    "FeedbackIssueType": {
      "description": "Coarse classification of reader-submitted page feedback.",
      "enum": [
        "translation",
        "extraction",
        "rendering",
        "other"
      ],
      "title": "FeedbackIssueType",
      "type": "string"
    }
  },
  "description": "A single reader feedback submission.",
  "properties": {
    "schema_version": {
      "default": "user_feedback.v1",
      "pattern": "^user_feedback\\.v\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9_]+$",
      "title": "Document Id",
      "type": "string"
    },
    "edition": {
      "pattern": "^[a-z]{2}$",
      "title": "Edition",
      "type": "string"
    },
    "page_id": {
      "pattern": "^p\\d{4}$",
      "title": "Page Id",
      "type": "string"
    },
    "issue_type": {
      "$ref": "#/$defs/FeedbackIssueType"
    },
    "note": {
      "default": "",
      "maxLength": 4000,
      "title": "Note",
      "type": "string"
    },
    "url": {
      "default": "",
      "maxLength": 2048,
      "title": "Url",
      "type": "string"
    },
    "user_agent": {
      "default": "",
      "maxLength": 512,
      "title": "User Agent",
      "type": "string"
    },
    "timestamp": {
      "maxLength": 64,
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "edition",
    "page_id",
    "issue_type",
    "timestamp"
  ],
  "title": "FeedbackSubmissionV1",
  "type": "object"
}
