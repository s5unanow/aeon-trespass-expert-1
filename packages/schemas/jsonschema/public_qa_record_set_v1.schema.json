          "title": "Qa Id",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/QALayer"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "page_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        },
        "entity_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Ref"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "waived": {
          "default": false,
