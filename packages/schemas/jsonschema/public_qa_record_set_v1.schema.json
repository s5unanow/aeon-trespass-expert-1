  "properties": {
    "schema_version": {
      "default": "public_qa_record_set.v1",
      "pattern": "^public_qa_record_set\\.v\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/PublicQARecordV1"
      },
      "title": "Records",
      "type": "array"
    }
  },
  "title": "PublicQARecordSetV1",
  "type": "object"
