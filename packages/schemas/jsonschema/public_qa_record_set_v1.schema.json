        "layer",
        "severity",
        "code"
      ],
      "title": "PublicQARecordV1",
      "type": "object"
    },
    "QALayer": {
      "enum": [
        "extraction",
        "structure",
        "terminology",
        "icon_symbol",
        "asset_link",
        "render",
        "visual",
        "accessibility",
        "user_feedback"
