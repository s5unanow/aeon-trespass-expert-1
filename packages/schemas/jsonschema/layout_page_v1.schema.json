{
  "$defs": {
    "DifficultyScoreV1": {
      "description": "Per-page difficulty classification.",
      "properties": {
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "column_count": {
          "default": 1,
          "title": "Column Count",
          "type": "integer"
        },
        "zone_overlap_ratio": {
          "default": 0.0,
          "title": "Zone Overlap Ratio",
          "type": "number"
        },
        "native_text_coverage": {
          "default": 1.0,
          "title": "Native Text Coverage",
          "type": "number"
        },
        "extractor_agreement": {
          "default": 1.0,
          "title": "Extractor Agreement",
          "type": "number"
        },
        "hard_page": {
          "default": false,
          "title": "Hard Page",
          "type": "boolean"
        },
        "recommended_route": {
          "default": "R1",
          "title": "Recommended Route",
          "type": "string"
        }
      },
      "required": [
        "page_id"
      ],
      "title": "DifficultyScoreV1",
      "type": "object"
    },
    "LayoutZone": {
      "description": "A detected layout zone on a page.",
      "properties": {
        "zone_id": {
          "title": "Zone Id",
          "type": "string"
        },
        "kind": {
          "default": "",
          "title": "Kind",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/Rect"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "zone_id",
        "bbox"
      ],
      "title": "LayoutZone",
      "type": "object"
    },
    "Rect": {
      "description": "Bounding box in PDF points: [x0, y0, x1, y1].",
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "Rect",
      "type": "object"
    },
    "WordEvidence": {
      "description": "A single word extracted from the PDF.",
      "properties": {
        "word_id": {
          "title": "Word Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/Rect"
        },
        "font_name": {
          "default": "",
          "title": "Font Name",
          "type": "string"
        },
        "font_size": {
          "default": 0.0,
          "title": "Font Size",
          "type": "number"
        },
        "flags": {
          "default": 0,
          "title": "Flags",
          "type": "integer"
        }
      },
      "required": [
        "word_id",
        "text",
        "bbox"
      ],
      "title": "WordEvidence",
      "type": "object"
    }
  },
  "description": "Secondary layout evidence for a single page.",
  "properties": {
    "schema_version": {
      "default": "layout_page.v1",
      "pattern": "^layout_page\\.v\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "page_id": {
      "pattern": "^p\\d{4}$",
      "title": "Page Id",
      "type": "string"
    },
    "zones": {
      "items": {
        "$ref": "#/$defs/LayoutZone"
      },
      "title": "Zones",
      "type": "array"
    },
    "reading_order_candidates": {
      "items": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Reading Order Candidates",
      "type": "array"
    },
    "difficulty": {
      "anyOf": [
        {
          "$ref": "#/$defs/DifficultyScoreV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ocr_words": {
      "description": "OCR-derived text evidence populated by the hard-page fallback. Each entry corresponds to a detected text *line* (PaddleOCR emits line-level polygons, not per-word tokens). The field reuses WordEvidence for coordinate/text typing; downstream consumers should treat entries as line-level granularity.",
      "items": {
        "$ref": "#/$defs/WordEvidence"
      },
      "title": "Ocr Words",
      "type": "array"
    },
    "extraction_path": {
      "default": "primary",
      "description": "Which extraction route produced this layout. One of: 'primary' (Docling-only, no fallback selected), 'ocr_fallback' (PaddleOCR ran for a hard page and its zones were used in place of the primary extractor's), 'extraction_failed' (both primary and OCR produced nothing usable; layout is a degenerate marker page). Set by ExtractLayoutStage; consumed by StructureStage to populate FallbackProvenance on resolved blocks. Default 'primary' preserves backward compatibility with pre-S5U-589 artifacts.",
      "title": "Extraction Path",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "page_id"
  ],
  "title": "LayoutPageV1",
  "type": "object"
}
