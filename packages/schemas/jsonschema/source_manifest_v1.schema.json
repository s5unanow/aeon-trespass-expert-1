{
  "$defs": {
    "ImageEntryV1": {
      "description": "Descriptor for one page image within an image-set source.\n\n- page_id uses the canonical pNNNN form for stable page identity.\n- sha256 is the hex digest of the raw image file bytes (filled by ingest).\n- path is relative to the manifest or repo root (resolved safely at ingest).",
      "properties": {
        "page_id": {
          "pattern": "^p\\d{4}$",
          "title": "Page Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        }
      },
      "required": [
        "page_id",
        "path"
      ],
      "title": "ImageEntryV1",
      "type": "object"
    },
    "PageEntry": {
      "description": "Metadata for a single source page.",
      "properties": {
        "page_id": {
          "pattern": "^p\\d{4}$",
          "title": "Page Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "raster_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raster Ref"
        }
      },
      "required": [
        "page_id",
        "page_number"
      ],
      "title": "PageEntry",
      "type": "object"
    }
  },
  "description": "Registered source document and its pages.\n\nPDF sources populate source_pdf_sha256 (historical field).\nImage-set sources populate the complement source_image_set_sha256 and\nmay list per-image details in image_entries. The two fingerprint fields\ncoexist; neither overloads the other.",
  "properties": {
    "schema_version": {
      "default": "source_manifest.v1",
      "pattern": "^source_manifest\\.v\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "source_pdf_sha256": {
      "default": "",
      "title": "Source Pdf Sha256",
      "type": "string"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageEntry"
      },
      "title": "Pages",
      "type": "array"
    },
    "config_hash": {
      "default": "",
      "title": "Config Hash",
      "type": "string"
    },
    "extractor_version": {
      "default": "",
      "title": "Extractor Version",
      "type": "string"
    },
    "source_image_set_sha256": {
      "default": "",
      "title": "Source Image Set Sha256",
      "type": "string"
    },
    "image_entries": {
      "items": {
        "$ref": "#/$defs/ImageEntryV1"
      },
      "title": "Image Entries",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "page_count",
    "pages"
  ],
  "title": "SourceManifestV1",
  "type": "object"
}
