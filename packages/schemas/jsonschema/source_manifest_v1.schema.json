{
  "$defs": {
    "PageEntry": {
      "description": "Metadata for a single source page.",
      "properties": {
        "page_id": {
          "pattern": "^p\\d{4}$",
          "title": "Page Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "raster_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raster Ref"
        }
      },
      "required": [
        "page_id",
        "page_number"
      ],
      "title": "PageEntry",
      "type": "object"
    },
    "SourceImageRef": {
      "description": "A raw source image registered by image-set ingest.\n\n``sha256`` is the hex digest of the raw file bytes as stored (the artifact\nis content-addressed by the same digest). ``artifact_ref`` is the relative\npath within the artifact store.",
      "properties": {
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "extension": {
          "description": "File extension including the leading dot.",
          "title": "Extension",
          "type": "string"
        },
        "width_px": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Px"
        },
        "height_px": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Px"
        },
        "artifact_ref": {
          "default": "",
          "title": "Artifact Ref",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "sha256",
        "page_number",
        "media_type",
        "extension"
      ],
      "title": "SourceImageRef",
      "type": "object"
    }
  },
  "description": "Registered source document and its pages.",
  "properties": {
    "schema_version": {
      "default": "source_manifest.v1",
      "pattern": "^source_manifest\\.v\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "source_kind": {
      "default": "pdf",
      "enum": [
        "pdf",
        "image_set"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_pdf_sha256": {
      "default": "",
      "title": "Source Pdf Sha256",
      "type": "string"
    },
    "source_image_set_sha256": {
      "default": "",
      "title": "Source Image Set Sha256",
      "type": "string"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageEntry"
      },
      "title": "Pages",
      "type": "array"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/SourceImageRef"
      },
      "title": "Images",
      "type": "array"
    },
    "config_hash": {
      "default": "",
      "title": "Config Hash",
      "type": "string"
    },
    "extractor_version": {
      "default": "",
      "title": "Extractor Version",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "page_count",
    "pages"
  ],
  "title": "SourceManifestV1",
  "type": "object"
}
