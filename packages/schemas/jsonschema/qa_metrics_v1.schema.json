{
  "$defs": {
    "FallbackSummary": {
      "description": "Run-level translation provider-fallback aggregate (S5U-1226).\n\nThe translate stage records ``fallback_used`` + ``primary_error`` per page\nin the ``translation_meta.v1`` artifact; the QA stage folds those into this\naggregate so a whole-run quality degradation (\"N/M pages used the fallback\nprovider\") is visible in the persisted QA metrics instead of being buried\nin per-page metadata. ``pages_with_meta`` is the denominator — only pages\nthat actually have a translation_meta artifact count toward the rate, so a\nsource-only (EN) QA run reports ``pages_with_meta == 0`` and a 0.0 rate.",
      "properties": {
        "pages_with_meta": {
          "default": 0,
          "title": "Pages With Meta",
          "type": "integer"
        },
        "fallback_pages": {
          "default": 0,
          "title": "Fallback Pages",
          "type": "integer"
        },
        "fallback_rate": {
          "default": 0.0,
          "title": "Fallback Rate",
          "type": "number"
        },
        "primary_errors": {
          "items": {
            "type": "string"
          },
          "title": "Primary Errors",
          "type": "array"
        }
      },
      "title": "FallbackSummary",
      "type": "object"
    },
    "FindingCodeCount": {
      "description": "Count of QA findings grouped by rule code.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "code"
      ],
      "title": "FindingCodeCount",
      "type": "object"
    },
    "SeverityCounts": {
      "description": "Counts by severity level.",
      "properties": {
        "info": {
          "default": 0,
          "title": "Info",
          "type": "integer"
        },
        "warning": {
          "default": 0,
          "title": "Warning",
          "type": "integer"
        },
        "error": {
          "default": 0,
          "title": "Error",
          "type": "integer"
        },
        "critical": {
          "default": 0,
          "title": "Critical",
          "type": "integer"
        }
      },
      "title": "SeverityCounts",
      "type": "object"
    }
  },
  "description": "Per-run QA metrics artifact.\n\nAll distribution fields (by-severity / by-layer / by-code) reflect\n**active** (non-waived) records only. Waived records are tallied\nseparately in ``waived_count`` so health reporting isn't inflated by\nintentionally-suppressed findings.",
  "properties": {
    "schema_version": {
      "default": "qa_metrics.v1",
      "pattern": "^qa_metrics\\.v\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "edition": {
      "default": "",
      "title": "Edition",
      "type": "string"
    },
    "timestamp": {
      "default": "",
      "title": "Timestamp",
      "type": "string"
    },
    "pages_total": {
      "default": 0,
      "title": "Pages Total",
      "type": "integer"
    },
    "pages_with_findings": {
      "default": 0,
      "title": "Pages With Findings",
      "type": "integer"
    },
    "clean_page_rate": {
      "default": 0.0,
      "title": "Clean Page Rate",
      "type": "number"
    },
    "findings_by_severity": {
      "$ref": "#/$defs/SeverityCounts"
    },
    "findings_by_layer": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Findings By Layer",
      "type": "object"
    },
    "findings_by_code_top10": {
      "items": {
        "$ref": "#/$defs/FindingCodeCount"
      },
      "title": "Findings By Code Top10",
      "type": "array"
    },
    "waived_count": {
      "default": 0,
      "title": "Waived Count",
      "type": "integer"
    },
    "blocking_count": {
      "default": 0,
      "title": "Blocking Count",
      "type": "integer"
    },
    "avg_findings_per_page": {
      "default": 0.0,
      "title": "Avg Findings Per Page",
      "type": "number"
    },
    "translation_fallback": {
      "$ref": "#/$defs/FallbackSummary"
    }
  },
  "required": [
    "document_id"
  ],
  "title": "QAMetricsV1",
  "type": "object"
}
